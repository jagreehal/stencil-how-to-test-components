{
  "name": "stencil-how-to-test-components",
  "version": "1.0.0",
  "description": "stencil how to test components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run clean && stencil build",
    "clean": "rimraf dist",
    "copy:static": "cp -r ./static/ ./dist",
    "deploy": "gh-pages -d dist",
    "dev": "stencil build --dev --watch --serve",
    "lint": "eslint src/**/*.tsx",
    "serve": "stencil-dev-server",
    "serve:prod": "npm run build && npm run copy:static && serve ./dist",
    "start": "npm run dev",
    "test:watch": "stencil test --spec --e2e --watchAll",
    "test:unit": "stencil test --spec",
    "test:e2e": "stencil test --e2e",
    "test:screenshot": "stencil test --e2e --screenshot"
  },
  "author": "Jag Reehal",
  "license": "ISC",
  "dependencies": {
    "@stencil/core": "^4.38.3"
  },
  "devDependencies": {
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.30.0",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
